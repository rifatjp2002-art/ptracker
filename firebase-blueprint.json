{
  "entities": {
    "cycle": {
      "title": "Cycle Log",
      "description": "Menstrual cycle log entry per user",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "startDate": {
          "type": "string",
          "description": "ISO date string YYYY-MM-DD"
        },
        "durationDays": {
          "type": "number",
          "description": "Duration of period in days"
        },
        "flow": {
          "type": "string",
          "description": "Flow intensity: light, medium, heavy"
        },
        "symptoms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of logged symptoms"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "startDate"]
    }
  }
}
